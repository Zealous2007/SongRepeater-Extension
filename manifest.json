{
  "manifest_version": 3,
  "name": "SoundCloudRepeat",
  "version": "1.0",
  "description": "X to kill",
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.soundcloud.com/*"],
      "js": ["content.js"]
    }
  ]
}